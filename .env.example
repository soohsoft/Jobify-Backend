# Server
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jobify

# Auth
JWT_SECRET=jobify-dev-secret-change-me
JWT_ISSUER=jobify-backend

# Scraper internal API (separate Node service)
SCRAPER_INTERNAL_API_KEY=jobify-scraper-dev-key-change-me

# WaafiPay (Hormuud)
WAAFI_API_KEY=
WAAFI_ACCOUNT_ID=
WAAFI_API_URL=https://api.waafipay.net
WAAFI_VERIFY_URL=https://api.waafipay.net/v1/payments/verify
WAAFI_CALLBACK_URL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Email (signup verification code) ---------------------------------------
# Empty SMTP_HOST means console mode: the code is written to the server log instead
# of being mailed, which is how the flow is exercised in development.
#
# Gmail: host smtp.gmail.com, port 587, STARTTLS, username = the full Gmail address,
# and SMTP_PASSWORD = a 16-character APP PASSWORD (Google account -> Security ->
# 2-Step Verification -> App passwords). A normal account password is rejected —
# Google blocks plain-password SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_FROM_NAME=Jobify
SMTP_USERNAME=
SMTP_PASSWORD=
# Used to build links in email templates.
APP_BASE_URL=http://localhost:5173
