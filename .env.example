# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# `*` = CorsLayer::permissive(). A specific origin restricts the browser client to it.
CORS_ORIGIN=*

# --- Mongo --------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/jobify
MONGODB_DB_NAME=jobify

# --- Auth ---------------------------------------------------------------------
# Signs every JWT. Change this in production; tokens signed with the old value stop working.
JWT_SECRET=
JWT_ISSUER=jobify-backend

# The scraper (a separate Node app) sends this as the `x-api-key` header on
# /internal/sources, /internal/jobs, /internal/matches/refresh and /internal/deliveries*.
SCRAPER_INTERNAL_API_KEY=

# --- Email: the signup / reset verification code ------------------------------
# SMTP_HOST EMPTY = console mode: the code is written to the server log instead of sent.
# That is what keeps the flow testable with no mailbox credentials. Fill host + username +
# password together — a host with no password stays in console mode on purpose, because a
# half-filled .env would otherwise mail nothing and log nothing.
#
# Gmail: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# The app password is 16 characters shown in four groups of four; the spaces are cosmetic.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | tls (465, implicit) | none (dev only)
SMTP_TLS=starttls
SMTP_FROM=
SMTP_FROM_NAME=Jobify
SMTP_USERNAME=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:5173

# --- Assistant (purpose-bound LLM) --------------------------------------------
# OpenAI-compatible chat-completions base. The assistant makes ONE JSON call (routing) and,
# for a search with rows, one short phrasing call. Nothing else uses the provider.
# `LLM_*` wins; the historical `DEEPSEEK_*` names are accepted when these are empty.
# An empty key means every assistant call answers 502 `llm_unavailable` and charges nothing.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Free smart queries per 30-day period before the purchased balance is touched.
SUBSCRIPTION_MONTHLY_SMART_QUERIES=30
