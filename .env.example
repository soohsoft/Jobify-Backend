# Copy to .env and fill in. .env is gitignored; never commit real values.
DISCORD_TOKEN=
DISCORD_APP_ID=1574835560315363418
DISCORD_PUBLIC_KEY=

# The Rust API. Internal routes need SCRAPER_INTERNAL_API_KEY (x-api-key).
BACKEND_BASE_URL=http://127.0.0.1:3000
SCRAPER_INTERNAL_API_KEY=

# The web portal, used for job links and the one-time account link.
APP_BASE_URL=http://localhost:5173

# Daily digest. Any IANA zone; the hour is local to that zone.
DIGEST_TZ=Africa/Nairobi
DIGEST_HOUR=8

# debug | info | warn | error
LOG_LEVEL=info
